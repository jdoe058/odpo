[Unit]
Description=Gunicorn daemon for odpo_prod
After=network.target

[Service]
Type=notify
User=sa
Group=sa
WorkingDirectory=/home/sa/odpo_prod

# Создаёт /run/gunicorn/ с нужным владельцем и правами
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0755

# Переменные окружения (секреты, настройки)
EnvironmentFile=-/home/sa/odpo_prod/.env

ExecStart=/home/sa/odpo_prod/venv/bin/gunicorn \
    --config /home/sa/odpo_prod/gunicorn.conf.py \
    config.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target